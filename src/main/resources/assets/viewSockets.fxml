<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/fxml" fx:controller="com.clientFX.CtrlBoard" 
      spacing="15" style="-fx-padding: 15;">
    <!-- Izquierda: Tablero -->
    <VBox spacing="10" alignment="CENTER">
        <Label fx:id="lblCurrentPlayer" text="Juga: -" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
        <GridPane fx:id="gridSudoku" alignment="CENTER" style="-fx-grid-lines-visible: false;"/>
    </VBox>

    <!-- Derecha: Llista de Jugadors i Puntuació -->
    <VBox spacing="10" prefWidth="200">
        <Label text="Jugadors / Punts" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <ListView fx:id="listPlayers" VBox.vgrow="ALWAYS"/>
    </VBox>
</HBox>