<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" focusTraversable="true" minHeight="620.0" minWidth="760.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clientFX.CtrlGame">
   <top>
      <VBox spacing="4.0">
         <padding>
            <Insets bottom="4.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <Label fx:id="txtPlayer" text="Juga: ">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
            <Label fx:id="txtInfo" text="Selecciona una casella i prem un número de l'1 al 9" />
         </children>
      </VBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="14.0">
         <children>
            <GridPane fx:id="gridBoard" alignment="CENTER" />
            <HBox fx:id="boxPad" alignment="CENTER" spacing="6.0" />
         </children>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="210.0" spacing="8.0" style="-fx-background-color: #f4f4f4;">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <Label text="Jugadors">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <VBox fx:id="listPlayers" spacing="6.0" />
         </children>
      </VBox>
   </right>
</BorderPane>
