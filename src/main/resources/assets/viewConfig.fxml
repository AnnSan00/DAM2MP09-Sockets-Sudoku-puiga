<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="500.0" minWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clientFX.CtrlConfig">
   <children>
      <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Sudoku multijugador">
               <font>
                  <Font size="36.0" />
               </font>
               <VBox.margin>
                  <Insets top="16.0" />
               </VBox.margin>
            </Label>
            <Pane VBox.vgrow="ALWAYS" />
            <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
               <children>
                  <Label text="Nom del jugador" GridPane.halignment="RIGHT" />
                  <TextField fx:id="txtName" prefWidth="200.0" promptText="El teu nom" GridPane.columnIndex="1" />
                  <Label text="Protocol" GridPane.halignment="RIGHT" GridPane.rowIndex="1" />
                  <TextField fx:id="txtProtocol" text="ws" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Server IP" GridPane.halignment="RIGHT" GridPane.rowIndex="2" />
                  <TextField fx:id="txtHost" text="localhost" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Port" GridPane.halignment="RIGHT" GridPane.rowIndex="3" />
                  <TextField fx:id="txtPort" text="3000" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            <Button mnemonicParsing="false" onAction="#connectToServer" text="Connecta">
               <VBox.margin>
                  <Insets top="16.0" />
               </VBox.margin>
            </Button>
            <Label fx:id="txtMessage">
               <VBox.margin>
                  <Insets bottom="16.0" top="8.0" />
               </VBox.margin>
            </Label>
            <Pane VBox.vgrow="ALWAYS" />
            <HBox alignment="BOTTOM_LEFT" spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#setConfigLocal" text="Local" />
                  <Button mnemonicParsing="false" onAction="#setConfigProxmox" text="Proxmox" />
               </children>
               <VBox.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
